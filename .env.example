# --- LLM providers ---
# Which provider to use for vision fallback + extraction: "anthropic", "openai", or "groq"
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_MODEL=gpt-4o
# Groq is OpenAI-API-compatible; used mainly for cheap/fast local demo runs.
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=llama-3.2-90b-vision-preview

# --- Database ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=docprocessor
POSTGRES_USER=docprocessor
POSTGRES_PASSWORD=docprocessor

# --- Redis / Celery ---
REDIS_HOST=localhost
REDIS_PORT=6379
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- Storage ---
UPLOAD_DIR=./data/uploads
PROCESSED_DIR=./data/processed

# --- Confidence routing thresholds (0-1) ---
AUTO_APPROVE_CONFIDENCE_THRESHOLD=0.90
FAST_REVIEW_CONFIDENCE_THRESHOLD=0.70

# --- OCR ---
OCR_MIN_TEXT_DENSITY_CHARS_PER_PAGE=40
